# Copy this file to .env and fill in real values. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...

# Keep large data outside iCloud (see config.py)
FILINGLENS_DATA_DIR=~/filinglens-data

# SEC EDGAR requires contact details in the User-Agent
SEC_USER_AGENT="Your Name you@example.com"

# Optional: defaults to the docker-compose database
# DATABASE_URL=postgresql://filinglens:filinglens@127.0.0.1:5434/filinglens
